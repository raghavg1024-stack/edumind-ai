NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Classroom web server: enable only after the worker is deployed/configured.
VIDEO_WORKER_ENABLED=false
VIDEO_TRANSCRIPTION_ENABLED=false
# Worker-only, dedicated Supabase secret or service-role key. Never NEXT_PUBLIC_.
VIDEO_WORKER_SUPABASE_KEY=
# Prerecorded speech provider: deepgram or http (timestamped segments API).
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
STT_API_URL=
STT_API_KEY=
STT_MODEL=
# Optional absolute executable paths on your worker host.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Set to 4 on Vercel; defaults to 8 for local hosting.
NEXT_PUBLIC_UPLOAD_MAX_MB=8
